     static constexpr u32 PAGE_BITS = 12;
     static constexpr u32 PAGE_OFFSET_MASK = (1u << PAGE_BITS) - 1;
     /// Host pointer of the page holding `address` if it is plain memory, else null.
+    /// The page-table array is 8 MB, so a tight LDR/STR loop misses L1 on every access. Two
+    /// direct-mapped slots (even/odd virtual pages) cover a stack and a nearby buffer. The slots
+    /// are dropped whenever MemorySystem bumps its generation: the rasterizer nulls a page pointer
+    /// to force the slow path, and a stale host pointer would skip that.
     u8* FastPage(u32 address) const {
-        return page_pointers[address >> PAGE_BITS];
+        const u32 generation = memory.PagePointerGeneration();
+        const u32 index = address >> PAGE_BITS;
+        const unsigned slot = index & 1u;
+        if (generation != page_cache_generation) [[unlikely]] {
+            page_cache_generation = generation;
+            page_cache_index[0] = page_cache_index[1] = ~0u;
+        } else if (page_cache_index[slot] == index) [[likely]] {
+            return page_cache_ptr[slot];
+        }
+        u8* const page = page_pointers[index];
+        page_cache_index[slot] = index;
+        page_cache_ptr[slot] = page;
+        return page;
     }
 
