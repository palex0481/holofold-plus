         page_pointers = pages ? pages : NoPages();
+        // 0 never matches PagePointerGeneration(), so the next access reloads both slots.
+        page_cache_generation = 0;
+        page_cache_index[0] = page_cache_index[1] = ~0u;
+        page_cache_ptr[0] = page_cache_ptr[1] = nullptr;
     }
     static u8* const* NoPages();
     u8* const* page_pointers = NoPages();
+    mutable u32 page_cache_generation = 0;
+    mutable u32 page_cache_index[2] = {~0u, ~0u};
+    mutable u8* page_cache_ptr[2] = {nullptr, nullptr};
 
