 extern Values values;
 
+/// Apple/MoltenVK workarounds that can each be switched off to bisect stalls. Set by the frontend
+/// before the renderer is created; read on the emulation and render threads.
+struct AppleRendererToggles {
+    /// Probe FAIL_ON_PIPELINE_COMPILE_REQUIRED before handing a pipeline to the async worker.
+    /// MoltenVK compiles synchronously during the probe, so this is off by default.
+    bool pipeline_fast_path = false;
+    /// Skip small draws (<= 6 vertices) until their pipeline is built instead of waiting for it.
+    bool skip_unready_small_draws = true;
+    /// MVK_CONFIG_SYNCHRONOUS_QUEUE_SUBMITS = false (asynchronous queue submits).
+    bool async_queue_submits = true;
+};
+extern AppleRendererToggles apple_renderer;
