+#include <atomic>
 #include <cstddef>
 #include "audio_core/dsp_interface.h"
 #include "audio_core/sink.h"
@@ -36,10 +37,26 @@ void DspInterface::EnableStretching(bool enable) {
     enable_time_stretching = enable;
 }
 
+namespace {
+std::atomic<DspInterface::AudioTap> g_audio_tap{nullptr};
+std::atomic<void*> g_audio_tap_context{nullptr};
+void Tap(const s16* data, std::size_t frames) {
+    if (auto tap = g_audio_tap.load(std::memory_order_acquire)) {
+        tap(data, frames, g_audio_tap_context.load(std::memory_order_relaxed));
+    }
+}
+} // namespace
+
+void DspInterface::SetAudioTap(AudioTap tap, void* context) {
+    g_audio_tap_context.store(context, std::memory_order_relaxed);
+    g_audio_tap.store(tap, std::memory_order_release);
+}
+
 void DspInterface::OutputFrame(StereoFrame16 frame) {
     if (!sink) {
         return;
     }
+    Tap(frame.data()->data(), frame.size());
 
     if (sink->ImmediateSubmission()) {
         sink->PushSamples(frame.data(), frame.size());
@@ -57,6 +74,7 @@ void DspInterface::OutputSample(std::array<s16, 2> sample) {
     if (!sink) {
         return;
     }
+    Tap(sample.data(), 1);
 
     if (sink->ImmediateSubmission()) {
         sink->PushSamples(&sample, 1);
