-    const auto synchronous_queue_submits = Settings::values.async_presentation.GetValue();
+    // Queue submits stay asynchronous. Every vkQueueSubmit already takes scheduler.submit_mutex,
+    // which is the external synchronization Vulkan requires. MoltenVK's synchronous-submit mode
+    // makes vkQueueSubmit wait until the GPU finishes, and that wait is held under the same mutex:
+    // the present thread's copy then blocks the scheduler worker (and TickFrame's WaitWorker) for
+    // the whole frame, and a pipeline compile that lands inside a submit freezes the guest for
+    // seconds. Async presentation still has its own thread; it no longer needs synchronous submits.
+    constexpr auto synchronous_queue_submits = false;
